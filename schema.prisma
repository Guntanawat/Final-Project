datasource db {
  provider = "postgresql" // หรือ "mysql", "sqlite" ตามที่คุณใช้
  url      = env("DATABASE_URL") // จะใช้ environment variable สำหรับการเชื่อมต่อ
}

generator client {
  provider = "prisma-client-js"
}

model Users {
  id            Int       @id @default(autoincrement())
  name          String
  phone_number  String
  email         String    @unique
  password      String
  created_at    DateTime  @default(now())
  // is_verified   Boolean   @default(false) // For email verification status
  role          String    @default("member") // Role for access control (e.g., "member", "admin")
  appointments  Appointments[]
}

model Employees {
  id            Int          @id @default(autoincrement())
  name          String
  position      String
  phone_number  String      
  email         String       
  password      String
  created_at    DateTime     @default(now())
  appointments   Appointments[] // ✅ ไม่ต้องกำหนด @relation ในฝั่งนี้
}


