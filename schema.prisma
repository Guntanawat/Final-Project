model Appointments {
  id              Int       @id @default(autoincrement())
  name            String
  phone_number    String
  appointment_time DateTime
  status          String     @default("pending")
  created_at      DateTime   @default(now())

  employee_id     Int
  user_id         Int // ✅ ตรวจสอบว่ามีหรือไม่ (ต้องมีถ้าจะเชื่อมกับ Users)

 employee        Employees   @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  user            Users     @relation(fields: [user_id], references: [id], onDelete: Cascade) // ✅ ตรวจสอบว่ามีหรือไม่
}






